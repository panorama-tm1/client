# Panorama.Push.v11: template, Panorama fills in the {{...}} values (Update data).
# No parameter, no data source. Metadata and Data tabs: empty.

#=== PROLOG ==================================================================
# Panorama push, TM1 v11 (Windows), generated by Panorama (Update data).
# No TM1 credentials: the structure comes from the control dimensions, the
# rules and process code from the .rux and .pro files. The token can only
# push into this instance.
sPanoramaUrl = '{{PANORAMA_URL}}';
sInstanceId = '{{INSTANCE_ID}}';
sToken = '{{TOKEN}}';
# Data directory (holds the .pro and .rux files): leave empty, it is read
# from tm1s.cfg. Set it only if panorama_push_<instance>.log says not found.
sDataDir = '';
# Outbound HTTP proxy, only if TM1 needs one to reach Panorama.
sProxy = '';

sLogDir = GetProcessErrorFileDirectory;
sBase = sLogDir | 'panorama_push_' | sInstanceId;
sScript = sBase | '.ps1';
sParams = sBase | '.params';
sStruct = sBase | '.txt';
sLog = sBase | '.log';
sOk = sBase | '.ok';
IF(FileExists(sOk) = 1);
  ASCIIDelete(sOk);
ENDIF;

# Lines written as is: no quotes around values, no doubled double quotes.
DatasourceASCIIQuoteCharacter = '';
SetOutputEscapeDoubleQuote(sParams, 0);
SetOutputEscapeDoubleQuote(sStruct, 0);
SetOutputEscapeDoubleQuote(sScript, 0);
sTab = CHAR(9);

# --- Structure, from the control dimensions ------------------------------------
# C <cube> <dimensions...>, D <dimension>, P <process>. The script adds the
# rules (.rux) and the process code (.pro).
nCubes = DIMSIZ('}Cubes');
nCube = 1;
WHILE(nCube <= nCubes);
  sCube = DIMNM('}Cubes', nCube);
  sLine = 'C' | sTab | sCube;
  nDims = CubeDimensionCountGet(sCube);
  nDim = 1;
  WHILE(nDim <= nDims);
    sLine = sLine | sTab | TABDIM(sCube, nDim);
    nDim = nDim + 1;
  END;
  ASCIIOutput(sStruct, sLine);
  nCube = nCube + 1;
END;

nDims = DIMSIZ('}Dimensions');
nDim = 1;
WHILE(nDim <= nDims);
  sDim = DIMNM('}Dimensions', nDim);
  # Alternate hierarchies are listed as Dimension:Hierarchy.
  IF(SCAN(':', sDim) = 0);
    ASCIIOutput(sStruct, 'D' | sTab | sDim);
  ENDIF;
  nDim = nDim + 1;
END;

nProcesses = DIMSIZ('}Processes');
nProcess = 1;
WHILE(nProcess <= nProcesses);
  ASCIIOutput(sStruct, 'P' | sTab | DIMNM('}Processes', nProcess));
  nProcess = nProcess + 1;
END;

# --- Script parameters, read and deleted by the script first thing -------------
ASCIIOutput(sParams, 'PANORAMA_URL=' | sPanoramaUrl);
ASCIIOutput(sParams, 'INSTANCE_ID=' | sInstanceId);
ASCIIOutput(sParams, 'TOKEN=' | sToken);
ASCIIOutput(sParams, 'PROCESS_NAME=' | GetProcessName());
ASCIIOutput(sParams, 'DATA_DIR=' | sDataDir);
ASCIIOutput(sParams, 'LOG_DIR=' | sLogDir);
ASCIIOutput(sParams, 'PROXY=' | sProxy);
ASCIIOutput(sParams, 'STRUCT_FILE=' | sStruct);
ASCIIOutput(sParams, 'LOG_FILE=' | sLog);
ASCIIOutput(sParams, 'OK_FILE=' | sOk);

# --- The PowerShell script (TI has no HTTP client on v11) ----------------------
ASCIIOutput(sScript, 'param([string]$ParamFile)');
ASCIIOutput(sScript, '$ErrorActionPreference = ''Stop''');
ASCIIOutput(sScript, '$cfg = @{}');
ASCIIOutput(sScript, 'foreach ($line in @(Get-Content -LiteralPath $ParamFile -Encoding UTF8)) {');
ASCIIOutput(sScript, '    $i = $line.IndexOf(''='')');
ASCIIOutput(sScript, '    if ($i -gt 0) { $cfg[$line.Substring(0, $i).Trim([char]0xFEFF)] = $line.Substring($i + 1) }');
ASCIIOutput(sScript, '}');
ASCIIOutput(sScript, 'Remove-Item -LiteralPath $ParamFile -Force');
ASCIIOutput(sScript, 'function Write-PushLog([string]$Message) {');
ASCIIOutput(sScript, '    Add-Content -LiteralPath $cfg.LOG_FILE -Value ((Get-Date -Format s) + '' '' + $Message) -Encoding UTF8');
ASCIIOutput(sScript, '}');
ASCIIOutput(sScript, 'Set-Content -LiteralPath $cfg.LOG_FILE -Value ((Get-Date -Format s) + '' Panorama push to '' + $cfg.INSTANCE_ID) -Encoding UTF8');
ASCIIOutput(sScript, '$tab = [string][char]9');
ASCIIOutput(sScript, '$quote = [string][char]34');
ASCIIOutput(sScript, '');
ASCIIOutput(sScript, '# The .pro and .rux files sit in the data directory, which TI cannot name.');
ASCIIOutput(sScript, '# Candidates: the one set in the Prolog, DataBaseDirectory in the tm1s.cfg of');
ASCIIOutput(sScript, '# the TM1 server that started this script, then the usual layouts around the');
ASCIIOutput(sScript, '# logging directory (data and logs side by side, or logs inside the data');
ASCIIOutput(sScript, '# directory). The right one holds the .pro of the running process.');
ASCIIOutput(sScript, 'function Find-DataDir {');
ASCIIOutput(sScript, '    $candidates = New-Object System.Collections.Generic.List[string]');
ASCIIOutput(sScript, '    if ($cfg.DATA_DIR -ne '''') { $candidates.Add($cfg.DATA_DIR) }');
ASCIIOutput(sScript, '    try {');
ASCIIOutput(sScript, '        $proc = Get-CimInstance Win32_Process -Filter (''ProcessId='' + $PID)');
ASCIIOutput(sScript, '        $server = $null');
ASCIIOutput(sScript, '        for ($n = 0; $n -lt 6 -and $proc -and -not $server; $n++) {');
ASCIIOutput(sScript, '            $proc = Get-CimInstance Win32_Process -Filter (''ProcessId='' + $proc.ParentProcessId)');
ASCIIOutput(sScript, '            if ($proc -and $proc.Name -like ''tm1s*.exe'') { $server = $proc }');
ASCIIOutput(sScript, '        }');
ASCIIOutput(sScript, '        if (-not $server) {');
ASCIIOutput(sScript, '            Write-PushLog ''TM1 server process not found among the parents of this script''');
ASCIIOutput(sScript, '        } else {');
ASCIIOutput(sScript, '            Write-PushLog (''TM1 server '' + $server.CommandLine)');
ASCIIOutput(sScript, '            $binDir = Split-Path -Parent $server.ExecutablePath');
ASCIIOutput(sScript, '            $configDir = $binDir');
ASCIIOutput(sScript, '            if ($server.CommandLine -match (''-z\s*(?:'' + $quote + ''([^'' + $quote + '']+)'' + $quote + ''|(\S+))'')) {');
ASCIIOutput(sScript, '                $configDir = if ($Matches[1]) { $Matches[1] } else { $Matches[2] }');
ASCIIOutput(sScript, '            }');
ASCIIOutput(sScript, '            $cfgFile = Join-Path $configDir ''tm1s.cfg''');
ASCIIOutput(sScript, '            if (-not (Test-Path -LiteralPath $cfgFile)) {');
ASCIIOutput(sScript, '                Write-PushLog (''No '' + $cfgFile)');
ASCIIOutput(sScript, '            } else {');
ASCIIOutput(sScript, '                foreach ($l in @(Get-Content -LiteralPath $cfgFile)) {');
ASCIIOutput(sScript, '                    if ($l -match ''^\s*DataBaseDirectory\s*=\s*(.+?)\s*$'') {');
ASCIIOutput(sScript, '                        Write-PushLog ($cfgFile + '', DataBaseDirectory='' + $Matches[1])');
ASCIIOutput(sScript, '                        foreach ($d in $Matches[1].Split('';'')) {');
ASCIIOutput(sScript, '                            if ($d -eq '''') { continue }');
ASCIIOutput(sScript, '                            if ([IO.Path]::IsPathRooted($d)) { $candidates.Add($d) }');
ASCIIOutput(sScript, '                            else { $candidates.Add((Join-Path $configDir $d)); $candidates.Add((Join-Path $binDir $d)) }');
ASCIIOutput(sScript, '                        }');
ASCIIOutput(sScript, '                    }');
ASCIIOutput(sScript, '                }');
ASCIIOutput(sScript, '            }');
ASCIIOutput(sScript, '        }');
ASCIIOutput(sScript, '    } catch {');
ASCIIOutput(sScript, '        Write-PushLog (''tm1s.cfg lookup skipped: '' + $_.Exception.Message)');
ASCIIOutput(sScript, '    }');
ASCIIOutput(sScript, '    $candidates.Add($cfg.LOG_DIR)');
ASCIIOutput(sScript, '    try {');
ASCIIOutput(sScript, '        $parent = (Get-Item -LiteralPath $cfg.LOG_DIR).Parent');
ASCIIOutput(sScript, '        if ($parent) {');
ASCIIOutput(sScript, '            $candidates.Add($parent.FullName)');
ASCIIOutput(sScript, '            foreach ($sub in @(Get-ChildItem -LiteralPath $parent.FullName -Directory)) { $candidates.Add($sub.FullName) }');
ASCIIOutput(sScript, '        }');
ASCIIOutput(sScript, '    } catch {');
ASCIIOutput(sScript, '        Write-PushLog (''Logging directory not readable: '' + $_.Exception.Message)');
ASCIIOutput(sScript, '    }');
ASCIIOutput(sScript, '    foreach ($d in $candidates) {');
ASCIIOutput(sScript, '        if (Test-Path -LiteralPath (Join-Path $d ($cfg.PROCESS_NAME + ''.pro''))) { return $d }');
ASCIIOutput(sScript, '    }');
ASCIIOutput(sScript, '    throw (''data directory not found, tried '' + ($candidates -join '', '') + ''. Set sDataDir in the Prolog.'')');
ASCIIOutput(sScript, '}');
ASCIIOutput(sScript, '');
ASCIIOutput(sScript, 'function Get-Unquoted([string]$Value) {');
ASCIIOutput(sScript, '    if ($Value.Length -ge 2 -and $Value.StartsWith($quote) -and $Value.EndsWith($quote)) {');
ASCIIOutput(sScript, '        return $Value.Substring(1, $Value.Length - 2).Replace($quote + $quote, $quote)');
ASCIIOutput(sScript, '    }');
ASCIIOutput(sScript, '    return $Value');
ASCIIOutput(sScript, '}');
ASCIIOutput(sScript, '');
ASCIIOutput(sScript, '# A .pro file is code,value lines; 572 to 575 give the line count of the');
ASCIIOutput(sScript, '# Prolog, Metadata, Data and Epilog that follow, 562 and 586 the data source.');
ASCIIOutput(sScript, 'function Add-ProcessRecords([string]$Path, [string]$Name, $Out) {');
ASCIIOutput(sScript, '    $sections = @{ ''572'' = ''Prolog''; ''573'' = ''Metadata''; ''574'' = ''Data''; ''575'' = ''Epilog'' }');
ASCIIOutput(sScript, '    $lines = @(Get-Content -LiteralPath $Path -Encoding UTF8)');
ASCIIOutput(sScript, '    $type = ''''');
ASCIIOutput(sScript, '    $source = ''''');
ASCIIOutput(sScript, '    $i = 0');
ASCIIOutput(sScript, '    while ($i -lt $lines.Count) {');
ASCIIOutput(sScript, '        $comma = $lines[$i].IndexOf('','')');
ASCIIOutput(sScript, '        if ($comma -gt 0) {');
ASCIIOutput(sScript, '            $code = $lines[$i].Substring(0, $comma)');
ASCIIOutput(sScript, '            $value = $lines[$i].Substring($comma + 1)');
ASCIIOutput(sScript, '            if ($sections.ContainsKey($code)) {');
ASCIIOutput(sScript, '                $count = [int]$value');
ASCIIOutput(sScript, '                for ($k = 1; $k -le $count; $k++) { $Out.Add(''S'' + $tab + $Name + $tab + $sections[$code] + $tab + $lines[$i + $k]) }');
ASCIIOutput(sScript, '                $i += $count');
ASCIIOutput(sScript, '            } elseif ($code -eq ''562'') {');
ASCIIOutput(sScript, '                $type = Get-Unquoted $value');
ASCIIOutput(sScript, '            } elseif ($code -eq ''586'') {');
ASCIIOutput(sScript, '                $source = Get-Unquoted $value');
ASCIIOutput(sScript, '            }');
ASCIIOutput(sScript, '        }');
ASCIIOutput(sScript, '        $i++');
ASCIIOutput(sScript, '    }');
ASCIIOutput(sScript, '    $Out.Add(''T'' + $tab + $Name + $tab + $type + $tab + $source)');
ASCIIOutput(sScript, '}');
ASCIIOutput(sScript, '');
ASCIIOutput(sScript, '$web = @{ UseBasicParsing = $true; TimeoutSec = 600 }');
ASCIIOutput(sScript, 'if ($cfg.PROXY -ne '''') { $web.Proxy = $cfg.PROXY; $web.ProxyUseDefaultCredentials = $true }');
ASCIIOutput(sScript, 'try {');
ASCIIOutput(sScript, '    [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12');
ASCIIOutput(sScript, '    $dataDir = Find-DataDir');
ASCIIOutput(sScript, '    Write-PushLog (''Data directory '' + $dataDir)');
ASCIIOutput(sScript, '');
ASCIIOutput(sScript, '    # Structure written by the Prolog (C, D, P records), then the rules of');
ASCIIOutput(sScript, '    # each cube and the code of each process.');
ASCIIOutput(sScript, '    $out = New-Object System.Collections.Generic.List[string]');
ASCIIOutput(sScript, '    $cubes = 0');
ASCIIOutput(sScript, '    $processes = 0');
ASCIIOutput(sScript, '    foreach ($record in @(Get-Content -LiteralPath $cfg.STRUCT_FILE -Encoding UTF8)) {');
ASCIIOutput(sScript, '        $record = $record.Trim([char]0xFEFF)');
ASCIIOutput(sScript, '        if ($record -eq '''') { continue }');
ASCIIOutput(sScript, '        $out.Add($record)');
ASCIIOutput(sScript, '        $fields = $record.Split([char]9)');
ASCIIOutput(sScript, '        if ($fields[0] -eq ''C'') {');
ASCIIOutput(sScript, '            $cubes++');
ASCIIOutput(sScript, '            $rux = Join-Path $dataDir ($fields[1] + ''.rux'')');
ASCIIOutput(sScript, '            if (Test-Path -LiteralPath $rux) {');
ASCIIOutput(sScript, '                foreach ($ruleLine in @(Get-Content -LiteralPath $rux -Encoding UTF8)) { $out.Add(''R'' + $tab + $fields[1] + $tab + $ruleLine) }');
ASCIIOutput(sScript, '            }');
ASCIIOutput(sScript, '        } elseif ($fields[0] -eq ''P'') {');
ASCIIOutput(sScript, '            $processes++');
ASCIIOutput(sScript, '            $pro = Join-Path $dataDir ($fields[1] + ''.pro'')');
ASCIIOutput(sScript, '            if (Test-Path -LiteralPath $pro) { Add-ProcessRecords $pro $fields[1] $out }');
ASCIIOutput(sScript, '        }');
ASCIIOutput(sScript, '    }');
ASCIIOutput(sScript, '    $body = [Text.Encoding]::UTF8.GetBytes([string]::Join([string][char]10, $out))');
ASCIIOutput(sScript, '    Write-PushLog ([string]$cubes + '' cubes, '' + $processes + '' processes, '' + [Math]::Round($body.Length / 1KB) + '' KB'')');
ASCIIOutput(sScript, '');
ASCIIOutput(sScript, '    $url = $cfg.PANORAMA_URL.TrimEnd(''/'') + ''/worker/import/'' + [Uri]::EscapeDataString($cfg.INSTANCE_ID)');
ASCIIOutput(sScript, '    $resp = Invoke-RestMethod -Method Post -Uri $url -Headers @{ Authorization = ''Bearer '' + $cfg.TOKEN } -ContentType ''text/plain; charset=utf-8'' -Body $body @web');
ASCIIOutput(sScript, '    Write-PushLog (''Import queued, task '' + $resp.taskId + '' ('' + $resp.status + '')'')');
ASCIIOutput(sScript, '    Set-Content -LiteralPath $cfg.OK_FILE -Value $resp.taskId');
ASCIIOutput(sScript, '} catch {');
ASCIIOutput(sScript, '    $message = $_.Exception.Message');
ASCIIOutput(sScript, '    if ($_.ErrorDetails -and $_.ErrorDetails.Message) { $message = $message + '' '' + $_.ErrorDetails.Message }');
ASCIIOutput(sScript, '    Write-PushLog (''ERROR '' + $message)');
ASCIIOutput(sScript, '} finally {');
ASCIIOutput(sScript, '    Remove-Item -LiteralPath $cfg.STRUCT_FILE -Force -ErrorAction SilentlyContinue');
ASCIIOutput(sScript, '}');

#=== EPILOG ==================================================================
# The Prolog's files are released when its tab ends: run the script here.
sCommand = 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' | sScript | '" "' | sParams | '"';
ExecuteCommand(sCommand, 1);

# Normally already deleted by the script, unless PowerShell never started.
IF(FileExists(sParams) = 1);
  ASCIIDelete(sParams);
ENDIF;
IF(FileExists(sStruct) = 1);
  ASCIIDelete(sStruct);
ENDIF;

IF(FileExists(sOk) = 0);
  LogOutput('ERROR', 'Panorama push failed for ' | sInstanceId | ', details in ' | sLog);
  ProcessError;
ENDIF;
LogOutput('INFO', 'Panorama push: import queued for ' | sInstanceId | ', details in ' | sLog);
