# Panorama push, TM1 v12, generated by Panorama (Update data).
# No TM1 credentials: the structure comes from the control dimensions, the
# rules from CubeRuleGet. The token can only push into this instance.
sPanoramaUrl = '{{PANORAMA_URL}}';
sInstanceId = '{{INSTANCE_ID}}';
sToken = '{{TOKEN}}';

sFile = 'panorama_push_' | sInstanceId | '.txt';
# Lines written as is: no quotes around values, no doubled double quotes.
DatasourceASCIIQuoteCharacter = '';
SetOutputEscapeDoubleQuote(sFile, 0);
sTab = CHAR(9);
sLF = CHAR(10);
sCR = CHAR(13);

# --- Cubes, their dimensions and their rules -----------------------------------
# C <cube> <dimensions...>, then R <cube> <line> for each line of its rules.
nCubes = DIMSIZ('}Cubes');
nCube = 1;
WHILE(nCube <= nCubes);
  sCube = DIMNM('}Cubes', nCube);
  sLine = 'C' | sTab | sCube;
  nDims = CubeDimensionCountGet(sCube);
  nDim = 1;
  WHILE(nDim <= nDims);
    sLine = sLine | sTab | TABDIM(sCube, nDim);
    nDim = nDim + 1;
  END;
  ASCIIOutput(sFile, sLine);

  sRules = CubeRuleGet(sCube);
  WHILE(LONG(sRules) > 0);
    nPos = SCAN(sLF, sRules);
    IF(nPos = 0);
      sLine = sRules;
      sRules = '';
    ELSE;
      sLine = SUBST(sRules, 1, nPos - 1);
      sRules = DELET(sRules, 1, nPos);
    ENDIF;
    IF(LONG(sLine) > 0);
      IF(SUBST(sLine, LONG(sLine), 1) @= sCR);
        sLine = SUBST(sLine, 1, LONG(sLine) - 1);
      ENDIF;
    ENDIF;
    ASCIIOutput(sFile, 'R' | sTab | sCube | sTab | sLine);
  END;
  nCube = nCube + 1;
END;

# --- Dimensions, processes -----------------------------------------------------
nDims = DIMSIZ('}Dimensions');
nDim = 1;
WHILE(nDim <= nDims);
  sDim = DIMNM('}Dimensions', nDim);
  # Alternate hierarchies are listed as Dimension:Hierarchy.
  IF(SCAN(':', sDim) = 0);
    ASCIIOutput(sFile, 'D' | sTab | sDim);
  ENDIF;
  nDim = nDim + 1;
END;

# Names only: on v12 TI has no way to read the code of a process.
nProcesses = DIMSIZ('}Processes');
nProcess = 1;
WHILE(nProcess <= nProcesses);
  ASCIIOutput(sFile, 'P' | sTab | DIMNM('}Processes', nProcess));
  nProcess = nProcess + 1;
END;
